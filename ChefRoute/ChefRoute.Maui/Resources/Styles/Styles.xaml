<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource KitchenCream}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkDark}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="TopNavButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="KitchenPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentTerracotta}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="KitchenBlueButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource StateRunning}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="KitchenGreenButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource StateCompleted}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="KitchenSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource KitchenBeige}" />
        <Setter Property="TextColor" Value="{StaticResource InkDark}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="TextColor" Value="{StaticResource InkDark}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
